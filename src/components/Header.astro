---
const { activePage = "home" } = Astro.props;

const links = [
  { label: "Home", href: "/", id: "home" },
  { label: "Services", href: "/services/", id: "services" },
  { label: "About Us", href: "/about/", id: "about" },
  { label: "Contact", href: "/contact/", id: "contact" },
];

const phoneNumber = "9971664916";
const whatsappNumber = "919971664916";
---

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span aria-hidden="true">⌖</span>
      Okhla, Delhi <i></i> Local CCTV Installation &amp; Security Support
    </div>

    <div class="topbar-right">
      <a href={`tel:${phoneNumber}`}>☎ <span>Call Us</span></a>



      <a
  href={`https://wa.me/${whatsappNumber}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Alpha CCTV Solution on WhatsApp"
>
  <svg
    class="whatsapp-icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.64a11.9 11.9 0 0 0 5.78 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.19-3.47-8.42ZM12.06 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.46 4.45-9.91 9.92-9.91a9.84 9.84 0 0 1 7.01 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.46-4.45 9.91-9.91 9.91Z"/>
  </svg>
  <span>WhatsApp</span>
</a>






      <span>◷ <span>Mon – Sun: 9AM – 8PM</span></span>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container nav-wrap">
   
   
   
    <a class="brand" href="/" aria-label="Alpha CCTV Solution home">
  <img
    src="/assets/images/branding/logo.png"
    alt="Alpha CCTV Solution — CCTV and security services"
  />
</a>




    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-menu" id="navMenu" aria-label="Main navigation">
      {links.map((link) => (
        <a
          class:list={["nav-link", { active: activePage === link.id }]}
          href={link.href}
        >
          {link.label}
        </a>
      ))}

      <a
        class="btn btn-whatsapp nav-cta"
        href={`https://wa.me/${whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with Alpha CCTV Solution on WhatsApp"
      >
        <svg
  class="whatsapp-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.64a11.9 11.9 0 0 0 5.78 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.19-3.47-8.42ZM12.06 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.98.99-3.63-.24-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.46 4.45-9.91 9.92-9.91a9.84 9.84 0 0 1 7.01 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.46-4.45 9.91-9.91 9.91Zm5.44-7.42c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
</svg>
        <span>+91 9971664916</span>
      </a>
    </nav>
  </div>
</header>