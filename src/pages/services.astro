---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Our Services | Alpha CCTV Solution"
  description="CCTV installation, setup, repair and security equipment services in Delhi NCR."
  activePage="services"
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">PROTECTION THAT FITS YOUR SPACE</p>
        <h1>Our CCTV &amp; Security Services</h1>
        <p>
          From a single home camera to a multi-camera business setup,
          get practical installation and support across Delhi NCR.
        </p>
      </div>
    </section>

    <section class="content-section container">
      <div class="card-grid">
        <article class="info-card product-card">
          <img src="/assets/images/products/cctv-camera.jpg" alt="CCTV camera for home installation" class="product-image" />
          <h3>Home CCTV Installation</h3>
          <p>Camera placement and setup for entrances, parking areas, corridors and other key home locations.</p>
        </article>

        <article class="info-card product-card">
          <img src="/assets/images/products/system-upgrade.jpg" alt="CCTV equipment for shop and office surveillance" class="product-image" />
          <h3>Office &amp; Shop Installation</h3>
          <p>Surveillance layouts for retail shops, offices, clinics and small businesses.</p>
        </article>

        <article class="info-card product-card">
          <img src="/assets/images/products/dvr-nvr.jpg" alt="DVR and NVR recording equipment" class="product-image" />
          <h3>DVR/NVR Setup</h3>
          <p>Recorder configuration, camera connection, storage setup and basic system checks.</p>
        </article>

        <article class="info-card product-card">
          <img src="/assets/images/products/cables-accessories.jpg" alt="CCTV cables and installation accessories" class="product-image" />
          <h3>Repair &amp; Maintenance</h3>
          <p>Help with camera faults, wiring issues, recording problems and routine maintenance.</p>
        </article>

        <article class="info-card product-card">
          <img src="/assets/images/products/networking-equipment.jpg" alt="Networking equipment for remote camera viewing" class="product-image" />
          <h3>Remote Mobile Viewing</h3>
          <p>Configuration support to view compatible cameras through a mobile application.</p>
        </article>

        <article class="info-card product-card">
          <img src="/assets/images/products/biometric-device.jpg" alt="Biometric attendance device" class="product-image" />
          <h3>Biometric Attendance</h3>
          <p>Installation assistance for biometric attendance devices and related setup.</p>
        </article>
      </div>

      <h2 style="margin-top:34px">Brands we work with</h2>
      <p>
        Hikvision, CP Plus, Dahua, Prama, TP-Link and D-Link.
        Brand and model availability can vary.
      </p>

      <div class="product-note">
        We can help you choose compatible cameras, recorders, cables,
        networking equipment and biometric devices. Equipment depends on
        your requirements and current availability. Product enquiries from
        outside Delhi NCR are welcome; on-site installation is limited to Delhi NCR.
      </div>

      <div class="product-note" style="margin-top:18px">
        Service area: Delhi NCR, including Okhla, Kalindi Kunj and South Delhi.
        Emergency support depends on technician availability.
      </div>

      <p style="margin-top:24px">
        <a class="btn btn-primary" href="/contact/">
          Request an Installation Quote →
        </a>
      </p>
    </section>
  </main>
</Layout>