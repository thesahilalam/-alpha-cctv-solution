---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About Us | Alpha CCTV Solution"
  description="About Alpha CCTV Solution, local CCTV installation and security support in Delhi NCR."
  activePage="about"
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">LOCAL EXPERIENCE. PRACTICAL SUPPORT.</p>
        <h1>About Alpha CCTV Solution</h1>
        <p>
          Helping homes and businesses improve security with CCTV installation,
          setup, repair and ongoing support across Delhi NCR.
        </p>
      </div>
    </section>

    <section class="content-section container">
      <div class="contact-layout">
        <div>
          <h2>Security solutions made practical</h2>
          <p>
            Alpha CCTV Solution focuses on CCTV and related security systems
            for homes, shops, offices and warehouses. We help customers choose
            suitable equipment, plan camera locations, set up recording and
            configure compatible mobile viewing.
          </p>
          <p>
            Our aim is straightforward: dependable installation, clear guidance
            and support when a system needs attention.
          </p>

          <div class="product-note">
            <strong>Experience:</strong> 6+ years, as provided by the business owner.
          </div>
        </div>

        <div class="card-grid" style="grid-template-columns:1fr 1fr">
          <article class="info-card">
            <span class="card-icon">✓</span>
            <h3>Skilled Technicians</h3>
            <p>Installation planned around the property and customer requirements.</p>
          </article>

          <article class="info-card">
            <span class="card-icon">⚒</span>
            <h3>After-Sales Support</h3>
            <p>Assistance with setup questions and service needs.</p>
          </article>

          <article class="info-card">
            <span class="card-icon">⌖</span>
            <h3>Local Coverage</h3>
            <p>Delhi NCR with focus on Okhla, Kalindi Kunj and South Delhi.</p>
          </article>

          <article class="info-card">
            <span class="card-icon">◉</span>
            <h3>Multiple Use Cases</h3>
            <p>Home, shop, office, warehouse and small business security.</p>
          </article>
        </div>
      </div>

      <p style="margin-top:28px">
        <a class="btn btn-primary" href="/contact/">
          Talk About Your Security Needs →
        </a>
      </p>
    </section>
  </main>
</Layout>